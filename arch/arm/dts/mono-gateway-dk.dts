/*
 * Device Tree Include file for Gateway Development Kit.
 *
 * Copyright 2025 Mono Technologies Inc.
 *
 * GPIOs 384-415, /soc/gpio@2330000: GPIO4[0-31] &gpio3
 * GPIOs 416-447, /soc/gpio@2320000: GPIO3[0-31] &gpio2
 * GPIOs 448-479, /soc/gpio@2310000: GPIO2[0-31] &gpio1
 * GPIOs 480-511, /soc/gpio@2300000: GPIO1[0-31] &gpio0
 *
 */

#include <dt-bindings/leds/common.h>
#include <dt-bindings/gpio/gpio.h>

/dts-v1/;
#include "fsl-ls1046a.dtsi"

/ {
	model = "Mono Gateway Development Kit";

	aliases {
		spi0 = &qspi;
		serial0 = &duart0;
		serial1 = &duart1;
		mdio0 = &mdio;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};
};

&soc {
	wdog0: watchdog@2ad0000 {
		compatible = "fsl,imx21-wdt";
		reg = <0x0 0x2ad0000 0x0 0x10000>;
		big-endian;
		status = "okay";
	};
};

&duart0 {
	bootph-all;
	status = "okay";
};

&duart1 {
	bootph-all;
	status = "okay";
};

&i2c0 {
	status = "okay";
};

&i2c1 {
	status = "okay";
};

&i2c2 {
	status = "okay";
};

&i2c3 {
	status = "okay";
};

&usb1 {
	status = "disabled";
};

&usb2 {
	status = "disabled";
};

&qspi {
	status = "okay";

	mt25qu512abb: flash@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		spi-max-frequency = <50000000>;
		reg = <0>;
		spi-tx-bus-width = <1>;
        spi-rx-bus-width = <4>;
	};

};

&esdhc {
	mmc-hs200-1_8v;
	bus-width = <4>;
	status = "okay";
};

#include "fsl-ls1046-post.dtsi"

&fman0 {
	ethernet@e0000 {
		status = "disabled";
	};

	ethernet@e4000 {
		status = "disabled";
	};

	ethernet@e6000 {
		status = "disabled";
	};

	ethernet@e8000 {
		phy-handle = <&sgmii_phy0>;
		phy-connection-type = "sgmii";
		status = "okay";
	};

	ethernet@ea000 {
		phy-handle = <&sgmii_phy1>;
		phy-connection-type = "sgmii";
		status = "okay";
	};

	ethernet@e2000 {
		phy-handle = <&sgmii_phy2>;
		phy-connection-type = "sgmii";
		status = "okay";
	};

	ethernet@f0000 { 
		fixed-link = <0 1 1000 0 0>;
		phy-connection-type = "xgmii";
		status = "okay";
	};

	ethernet@f2000 {
		fixed-link = <0 1 1000 0 0>;
		phy-connection-type = "xgmii";
		status = "okay";
	};

	mdio@fc000 {
		status = "disabled";
	};

	mdio: mdio@fd000 {
		sgmii_phy0: ethernet-phy@0 {
			reg = <0x0>;
		};

		sgmii_phy1: ethernet-phy@1 {
			reg = <0x1>;
		};

		sgmii_phy2: ethernet-phy@2 {
			reg = <0x2>;
		};
	};
};
