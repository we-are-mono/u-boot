/*
 * Device Tree Include file for Gateway Development Kit.
 *
 * Copyright 2025 Mono Technologies Inc.
 *
 * GPIOs 384-415, /soc/gpio@2330000: GPIO4[0-31] &gpio3
 * GPIOs 416-447, /soc/gpio@2320000: GPIO3[0-31] &gpio2
 * GPIOs 448-479, /soc/gpio@2310000: GPIO2[0-31] &gpio1
 * GPIOs 480-511, /soc/gpio@2300000: GPIO1[0-31] &gpio0
 *
 */

#include <dt-bindings/leds/common.h>
#include <dt-bindings/gpio/gpio.h>

/dts-v1/;
#include "fsl-ls1046a.dtsi"

/ {
	model = "Mono Gateway Development Kit";

	aliases {
		spi0 = &qspi;
		serial0 = &duart0;
		serial1 = &duart1;
		mdio0 = &xmdio0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};
};

&duart0 {
	bootph-all;
	status = "okay";
};

&duart1 {
	bootph-all;
	status = "okay";
};

&gpio0 {
    status = "okay";
};

&gpio1 {
    status = "okay";
};

&gpio2 {
    status = "okay";
};

&gpio3 {
    status = "okay";
};

&i2c0 {
	status = "okay";

	/* Thermal sensors, retimer, clock genenerator, PWM fan */
	i2c-mux@70 {
		compatible = "ti,pca9546";
		reg = <0x70>;
		#address-cells = <1>;
		#size-cells = <0>;
		reset-gpios = <&gpio2 25 GPIO_ACTIVE_LOW>;

		interrupt-parent = <&gpio0>;
		interrupts = <29 IRQ_TYPE_LEVEL_LOW>;
		interrupt-controller;
		#interrupt-cells = <2>;
	};
};

&i2c1 {
	status = "okay";

	/* SFP+ modules */
	sfpmux: i2c-mux@70 {
		compatible = "ti,pca9546";
		reg = <0x70>;
		#address-cells = <1>;
		#size-cells = <0>;
		reset-gpios = <&gpio2 24 GPIO_ACTIVE_LOW>;

		interrupt-parent = <&gpio0>;
		interrupts = <30 IRQ_TYPE_LEVEL_LOW>;
		interrupt-controller;
		#interrupt-cells = <2>;
    };
};

&i2c2 {
	status = "okay";

	/*  */
	i2c-mux@70 {
		compatible = "ti,pca9546";
		reg = <0x70>;
		#address-cells = <1>;
		#size-cells = <0>;
		reset-gpios = <&gpio2 23 GPIO_ACTIVE_LOW>;

		interrupt-parent = <&gpio0>;
		interrupts = <31 IRQ_TYPE_LEVEL_LOW>;
		interrupt-controller;
		#interrupt-cells = <2>;
	};
};

&qspi {
	status = "okay";

	mt25qu512a0: flash@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		spi-max-frequency = <50000000>;
		reg = <0>;
	};

};

&esdhc {
	mmc-hs200-1_8v;
	bus-width = <4>;
	status = "okay";
};

#include "fsl-ls1046-post.dtsi"

&fman0 {
	ethernet@e0000 {
		status = "disabled";
	};

	ethernet@e4000 {
		status = "disabled";
	};

	ethernet@e6000 {
		status = "disabled";
	};

	ethernet@e8000 {
		phy-handle = <&sgmii_phy0>;
		phy-connection-type = "sgmii";
		status = "okay";
	};

	ethernet@ea000 {
		phy-handle = <&sgmii_phy1>;
		phy-connection-type = "sgmii";
		status = "okay";
	};


	ethernet@e2000 {
		phy-handle = <&sgmii_phy2>;
		phy-connection-type = "sgmii";
		status = "okay";
	};

	ethernet@f0000 { 
		fixed-link = <0 1 1000 0 0>;
		phy-connection-type = "usxgmii";
		status = "okay";
	};

	ethernet@f2000 {
		fixed-link = <0 1 1000 0 0>;
		phy-connection-type = "usxgmii";
		status = "okay";
	};

	mdio@fd000 {
		sgmii_phy2: ethernet-phy@0 {
			compatible = "ethernet-phy-ieee802.3-c45";
			reg = <0x0>;
		};

		sgmii_phy0: ethernet-phy@1 {
			compatible = "ethernet-phy-ieee802.3-c45";
			reg = <0x1>;
		};

		sgmii_phy1: ethernet-phy@2 {
			compatible = "ethernet-phy-ieee802.3-c45";
			reg = <0x2>;
		};
	};
};
